{
  "name": "electron-app",
  "version": "1.0.2",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "build:frontend": "cd ../frontend && npm run build",
    "dist": "npm run build:frontend && electron-builder"
  },
  "author": "",
  "license": "ISC",
  "description": "Lolita Bronze - Sistema de Gestão",
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.lolitabronze.app",
    "productName": "Lolita Bronze App",

    "icon": "build/icon.ico",

    "directories": {
      "output": "dist-installer"
    },

    "files": [
      "index.js",
      "preload.js",
      "splash.html",
      "build/**/*"
    ],

    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/.cache",
          "!.git"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      }
    ],


    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lolita Bronze"
    }
  }
}